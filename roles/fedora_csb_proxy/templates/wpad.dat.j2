function FindProxyForURL(url, host) {
  if (dnsDomainIs(host,"auth.redhat.com")) {
    return "PROXY {{ fedora_csb_proxy_server }}";
  }
  if (dnsDomainIs(host,".cee.redhat.com")) {
    return "PROXY {{ fedora_csb_proxy_server }}";
  }
  if (dnsDomainIs(host,".corp.redhat.com")) {
    return "PROXY {{ fedora_csb_proxy_server }}";
  }
  if (dnsDomainIs(host,"token.redhat.com")) {
    return "PROXY {{ fedora_csb_proxy_server }}";
  }
  if (dnsDomainIs(host,"lwn.net")) {
    return "PROXY {{ fedora_csb_proxy_server }}";
  }
  return "DIRECT";
}
